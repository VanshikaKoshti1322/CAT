CAT.Case.onChange = async function (executionContext) {
    var formContext = executionContext.getFormContext();
    var elevationTypeAttr = formContext.getAttribute("cat_elevationtype");
    var parentCaseAttr = formContext.getAttribute("parentcaseid");
    var elevationtype = elevationTypeAttr ? elevationTypeAttr.getValue() : undefined;
    var parentcaseid = parentCaseAttr ? parentCaseAttr.getValue() : undefined;

    if (elevationtype && parentcaseid)
    {
		formContext.ui.process.setVisible(false);
		await CATCommon.applyRules(executionContext, ["ElevationRuleOnCaseLoad"]);
        await CATCommon.applyRules(executionContext, ["OnChangeCaseElevationTypeRule"]);
		if (CAT.Case.HandupFormSelector(executionContext)) return;
    }
    else
    {
		await CATCommon.applyRules(executionContext, ["ProductTechnologyRuleOnCaseLoad"]);
        await CATCommon.applyRules(executionContext, ["OnChangeCaseProductTechnologyRule"], true);
		if (CAT.Case.EnhanceCaseFormSelector(executionContext)) return;
    }

    await CAT.Case.onProductChange(executionContext);
}


