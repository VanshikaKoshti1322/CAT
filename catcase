CAT.CaseHandup.filterAssignmentGroupOnLoad = function (executionContext) {

    var formContext = executionContext.getFormContext();

    var assignmentGroupCtrl =
        formContext.getControl("cat_assignmentgroupid");

    if (assignmentGroupCtrl) {

        assignmentGroupCtrl.addPreSearch(function () {
            CAT.CaseHandup.applyAssignmentGroupFilter(formContext);
        });
    }
};


CAT.CaseHandup.applyAssignmentGroupFilter = function (formContext) {

    var handupType =
        formContext.getAttribute("cat_elevationtype").getValue();

    if (handupType === null) {
        return;
    }

    var assignmentGroupType = null;

    switch (handupType) {

        // SNOW -> SNOW
        case 100000000:
            assignmentGroupType = 100000000;
            break;

        // Manual -> Manual
        case 100000001:
            assignmentGroupType = 100000001;
            break;

        // SFDC -> SFDC
        case 100000002:
            assignmentGroupType = 100000002;
            break;

        // Dealer Consultation -> Dealer Handup
        case 100000003:
            assignmentGroupType = 100000003;
            break;

        // Dealer Customer Resolution -> Dealer Handup
        case 100000004:
            assignmentGroupType = 100000003;
            break;

        // Dynamics -> Dynamics
        case 100000005:
            assignmentGroupType = 100000004;
            break;
    }

    if (assignmentGroupType === null) {
        return;
    }

    var filterXml =
        "<filter type='and'>" +
        "<condition attribute='cat_assignmentgrouptype' operator='eq' value='" +
        assignmentGroupType +
        "' />" +
        "</filter>";

    formContext.getControl("cat_assignmentgroupid")
        .addCustomFilter(
            filterXml,
            "cat_assignmentgroup" 
        );
};
CAT.CaseHandup.setDefaultDealerAssignmentGroup = async function (formContext) {

    try {

        var handupType =
            formContext.getAttribute("cat_elevationtype").getValue();

        // Dealer Consultation or Dealer Customer Resolution
        if (handupType !== 100000003 &&
            handupType !== 100000004) {
            return;
        }

        // CCS Config record
        var config = await Xrm.WebApi.retrieveRecord(
            "cat_ccs_configuration",
            "1af967f7-dbb8-f111-aaac-7ced8d6fdee0",
            "?$select=cat_value"
        );

        if (!config || !config.cat_value) {
            return;
        }

        var assignmentGroupId =
            config.cat_value.replace(/[{}]/g, "");

        var assignmentGroupRecord =
            await Xrm.WebApi.retrieveRecord(
                "cat_assignmentgroup",
                assignmentGroupId,
                "?$select=cat_assignmentgroupname"
            );

        formContext.getAttribute("cat_assignmentgroupid").setValue([
            {
                id: assignmentGroupId,
                name: assignmentGroupRecord.cat_assignmentgroupname,
                entityType: "cat_assignmentgroup"
            }
		
        ]);
		//formContext.getControl("cat_assignmentgroupid").setDisabled(true);

    }
    catch (e) {
        console.error("Error setting default Dealer Group", e);
    }
};
CAT.CaseHandup.setDealerFieldsReadonly = function (executionContext) {
    var formContext = executionContext.getFormContext();

    var handupType = formContext.getAttribute("cat_elevationtype")?.getValue();

    // Dealer Customer Resolution or Dealer Consultation
    if (handupType === 100000003 || handupType === 100000004) {

        // Dealer Code (Text)
        var dealerCodeAttr = formContext.getAttribute("cat_dealercode");
        var dealerCodeCtrl = formContext.getControl("cat_dealercode");

        if (
            dealerCodeAttr &&
            dealerCodeCtrl &&
            dealerCodeAttr.getValue()
        ) {
            dealerCodeCtrl.setDisabled(true);
        }

        // Dealer Name (Lookup)
        var dealerNameAttr = formContext.getAttribute("cat_dealername");
        var dealerNameCtrl = formContext.getControl("cat_dealername");

        var dealerNameValue = dealerNameAttr?.getValue();

        if (
            dealerNameCtrl &&
            dealerNameValue &&
            dealerNameValue.length > 0
        ) {
            dealerNameCtrl.setDisabled(true);
        }
    }
};

function handleSnowRequest(executionContext) {

    var formContext = executionContext.getFormContext();

    var snowRequest = formContext.getAttribute("cat_snowrequest");
    var elevationType = formContext.getAttribute("cat_elevationtype");

    if (!snowRequest || !elevationType) {
        return;
    }

    var snowRequestValue = snowRequest.getValue();
    var elevationTypeValue = elevationType.getValue();

    var EXISTING = 100000001;
    var HANDUP = 100000000; // Elevation Type value

    var showExistingFields =
        (snowRequestValue === EXISTING) &&
        (elevationTypeValue === HANDUP);

    var trackingNumberControl = formContext.getControl("cat_trackingnumber");
    if (trackingNumberControl) {
 //  trackingNumberControl.setVisible(showExistingFields);
  trackingNumberControl.setDisabled(!showExistingFields);
    }

    var externalLinkControl = formContext.getControl("cat_externallink");
    if (externalLinkControl) {
  //      externalLinkControl.setVisible(showExistingFields);
  externalLinkControl.setDisabled(!showExistingFields);
    }
}

