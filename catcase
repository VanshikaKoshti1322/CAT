/**

* Fires when Requested For (customerid) changes

* Auto-populates Dealer Code ONLY when:

* 1. Requested For = Account

* 2. Account Type = Dealer (100000001)

*/

CAT.Case.onRequestedForChange = async function (executionContext) {

    try {

        var formContext = executionContext.getFormContext();

        var dealerCodeAttr = formContext.getAttribute("cat_dealercode");

        var dealerCodeCtrl = formContext.getControl("cat_dealercode");

        //  Safety: Dealer Code must exist on form

        if (!dealerCodeAttr) {

            console.log("cat_dealercode is not present on this form");

            return;

        }

        var customerAttr = formContext.getAttribute("customerid");

        if (!customerAttr) return;

        var customerLookup = customerAttr.getValue();

        // Helper to clear Dealer Code safely

        function clearDealerCode() {

            if (dealerCodeCtrl) dealerCodeCtrl.setDisabled(false);

            dealerCodeAttr.setValue(null);

            if (dealerCodeCtrl) dealerCodeCtrl.setDisabled(true);

        }

        //  Condition 1: Requested For is empty

        if (!customerLookup || customerLookup.length === 0) {

            clearDealerCode();

            return;

        }

        var customerValue = customerLookup[0];

        //  Condition 2: Requested For must be Account

        if (customerValue.entityType !== "account") {

            clearDealerCode();

            return;

        }

        // Clean GUID

        var accountId = customerValue.id.replace("{", "").replace("}", "");

        //  Retrieve Account Type + Dealer Code

        var account = await Xrm.WebApi.retrieveRecord(

            "account",

            accountId,

            "?$select=cat_accounttype,cat_authoringdealercode"

        );

        //  Condition 3: Account Type must be Dealer (100000001)

        if (account.cat_accounttype !== 100000001) {

            clearDealerCode();

            return;

        }

        // Populate Dealer Code

        if (account.cat_authoringdealercode) {

            if (dealerCodeCtrl) dealerCodeCtrl.setDisabled(false);

            dealerCodeAttr.setValue(account.cat_authoringdealercode);

            if (dealerCodeCtrl) dealerCodeCtrl.setDisabled(true);

        } else {

            clearDealerCode();

        }

    } catch (error) {

        console.error("Dealer Code auto-population failed:", error);

        Xrm.Utility.alertDialog(error.message);

    }

}



CAT.Case.populateCHI = async function (executionContext) {



    var formContext = executionContext.getFormContext();

    // Always clear existing CHI before recalculating

    formContext.getAttribute("cat_casehandlinginstruction").setValue(null);

    var requestedFor = formContext.getAttribute("customerid")?.getValue();

    var requestedBy = formContext.getAttribute("cat_requestedfrom")?.getValue();

    var productTechnology = formContext.getAttribute("productid")?.getValue();

    var dealerName = formContext.getAttribute("cat_dealername")?.getValue();

    var workstream = formContext.getAttribute("cat_workstream")?.getValue();

    try {

        if (!productTechnology) {

            return;

        }

        var customerId = requestedFor

            ? requestedFor[0].id.replace(/[{}]/g, "")

            : null;

        var requestedById = requestedBy

            ? requestedBy[0].id.replace(/[{}]/g, "")

            : null;

        var dealerId = dealerName

            ? dealerName[0].id.replace(/[{}]/g, "")

            : null;

        var productId = productTechnology[0].id.replace(/[{}]/g, "");

        var productName = productTechnology[0].name;

        var chiRecord = null;

        // =====================================================

        // PRIORITY 1

        // Parts.Cat.Com / SIS / Cat Central / Shop Cat

        // Cat FI / SIS2GO

        // Product + Dealer + Workstream != 100000001

        // =====================================================

        var specialProducts = [

            "parts.cat.com",

            "sis",

            "cat central",

            "shop cat",

            "cat fi",

            "sis2go"

        ];

        if (

            productName &&

            specialProducts.includes(productName.toLowerCase()) &&

            dealerId &&

            workstream !== 100000001

        ) {

            var specialQuery =

                "?$select=cat_casehandlinginstructionid,cat_name" +

                "&$filter=_cat_producttechnology_value eq " + productId +

                " and _cat_dealer_value eq " + dealerId;

            var specialResult =

                await Xrm.WebApi.retrieveMultipleRecords(

                    "cat_casehandlinginstruction",

                    specialQuery

                );

            if (specialResult.entities.length > 0) {

                chiRecord = specialResult.entities[0];

            }

        }

// =====================================================

// PRIORITY 2

// Subscription & Asset Administration

// Product Technology Match

// AND

// (Dealer OR Requested By OR Requested For)

// =====================================================

if (

    !chiRecord &&

    productName &&

    productName.toLowerCase() ===

        "subscription and asset administration"

) {

    // Dealer = CHI Dealer

    if (dealerId) {

        var dealerQuery =

            "?$select=cat_casehandlinginstructionid,cat_name" +

            "&$filter=_cat_producttechnology_value eq " + productId +

            " and _cat_dealer_value eq " + dealerId;

        var dealerResult =

            await Xrm.WebApi.retrieveMultipleRecords(

                "cat_casehandlinginstruction",

                dealerQuery

            );

        if (dealerResult.entities.length > 0) {

            chiRecord = dealerResult.entities[0];

        }

    }

    // Requested By = CHI Dealer

    if (!chiRecord && requestedById) {

        var requestedByQuery =

            "?$select=cat_casehandlinginstructionid,cat_name" +

            "&$filter=_cat_producttechnology_value eq " + productId +

            " and _cat_dealer_value eq " + requestedById;

        var requestedByResult =

            await Xrm.WebApi.retrieveMultipleRecords(

                "cat_casehandlinginstruction",

                requestedByQuery

            );

        if (requestedByResult.entities.length > 0) {

            chiRecord = requestedByResult.entities[0];

        }

    }

    // Requested For = CHI Dealer

    if (!chiRecord && customerId) {

        var requestedForQuery =

            "?$select=cat_casehandlinginstructionid,cat_name" +

            "&$filter=_cat_producttechnology_value eq " + productId +

            " and _cat_dealer_value eq " + customerId;

        var requestedForResult =

            await Xrm.WebApi.retrieveMultipleRecords(

                "cat_casehandlinginstruction",

                requestedForQuery

            );

        if (requestedForResult.entities.length > 0) {

            chiRecord = requestedForResult.entities[0];

        }

    }

}

var additionalApplication =

    formContext.getAttribute("cat_additionalapplications")?.getValue();

var additionalApplicationId =

    additionalApplication

        ? additionalApplication[0].id.replace(/[{}]/g, "")

        : null;

// =====================================================

// PRIORITY 3

// PRODUCT TECHNOLOGY = OTHER

// Product Technology + Additional Application

// =====================================================

if (

    !chiRecord &&

    productName &&

    productName.toLowerCase() === "other" &&

    additionalApplicationId

) {

    var otherQuery =

        "?$select=cat_casehandlinginstructionid,cat_name" +

        "&$filter=_cat_producttechnology_value eq " + productId +

        " and _cat_additionalapplication_value eq " + additionalApplicationId;

    var otherResult =

        await Xrm.WebApi.retrieveMultipleRecords(

            "cat_casehandlinginstruction",

            otherQuery

        );

    if (otherResult.entities.length > 0) {

        chiRecord = otherResult.entities[0];

    }

}

        // =====================================================

        // PRIORITY 4

        // Product Technology + Requested For

        // =====================================================

        if (!chiRecord && customerId) {

            var customerQuery =

                "?$select=cat_casehandlinginstructionid,cat_name" +

                "&$filter=_cat_producttechnology_value eq " + productId +

                " and _cat_dealer_value eq " + customerId;

            var customerResult =

                await Xrm.WebApi.retrieveMultipleRecords(

                    "cat_casehandlinginstruction",

                    customerQuery

                );

            if (customerResult.entities.length > 0) {

                chiRecord = customerResult.entities[0];

            }

        }

        // =====================================================

        // PRIORITY 5

        // Product Technology + Blank Dealer

        // =====================================================

        if (!chiRecord) {

            var defaultQuery =

                "?$select=cat_casehandlinginstructionid,cat_name" +

                "&$filter=_cat_producttechnology_value eq " + productId +

                " and _cat_dealer_value eq null";

            var defaultResult =

                await Xrm.WebApi.retrieveMultipleRecords(

                    "cat_casehandlinginstruction",

                    defaultQuery

                );

            if (defaultResult.entities.length > 0) {

                chiRecord = defaultResult.entities[0];

            }

        }

        // =====================================================

        // POPULATE CHI

        // =====================================================

        if (chiRecord) {

            formContext.getAttribute("cat_casehandlinginstruction").setValue([

                {

                    id: chiRecord.cat_casehandlinginstructionid,

                    name: chiRecord.cat_name,

                    entityType: "cat_casehandlinginstruction"

                }

            ]);

        }

    } catch (error) {

        console.error("Error populating CHI:", error);

        formContext.getAttribute("cat_casehandlinginstruction").setValue(null);

    }

};

