CAT.Case.onChangeDealerName = function (executionContext) {

    var formContext = executionContext.getFormContext();

    var parentCaseId = formContext.data.entity.getId().replace(/[{}]/g, "");

    var parentDealer = formContext.getAttribute("cat_dealername").getValue();

    var parentDealerId = null;

    if (parentDealer) {

        parentDealerId = parentDealer[0].id.replace(/[{}]/g, "");

        console.log("Parent Dealer ID:", parentDealerId);

    }

    else {

        console.log("Parent Dealer cleared. Child records will be cleared.");

    }

    Xrm.WebApi.retrieveMultipleRecords(

        "incident",

        "?$select=incidentid,cat_elevationtype&$filter=_parentcaseid_value eq " + parentCaseId

    ).then(

        function success(results) {

            console.log("Child Records Count:", results.entities.length);

            if (!results.entities || results.entities.length === 0) {

                console.log("No child records found.");

                return;

            }

            for (var i = 0; i < results.entities.length; i++) {

                var childCase = results.entities[i];

                var childCaseId = childCase.incidentid;

                var elevationType = childCase.cat_elevationtype;

                console.log("Child Case:", childCaseId);

                console.log("Elevation Type:", elevationType);

                // Update only Dealer Handups

                if (elevationType == 100000003 ||

                    elevationType == 100000004) {

                    console.log("Updating child case.");

                    var record = {};

                    if (parentDealerId) {

                        record["cat_DealerName@odata.bind"] =

                            "/accounts(" + parentDealerId + ")";

                    }

                    else {

                        record["cat_DealerName@odata.bind"] = null;

                    }

                    Xrm.WebApi.updateRecord(

                        "incident",

                        childCaseId.replace(/[{}]/g, ""),

                        record

                    ).then(

                        function success() {

                            console.log("Child updated successfully");

                        },

                        function (error) {

                            console.log("Update Error: " + error.message);

                        }

                    );

                    continue;

                }
 
            }

        },

        function (error) {

            console.log("Retrieve Error: " + error.message);

        }

    );

};
