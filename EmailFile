async function requiredToandSubject(formContext) {
    var attribute = formContext.getAttribute("to");
    if (attribute) {
        attribute.setRequiredLevel("required");
    }
    attribute = formContext.getAttribute("subject");
    if (attribute) {
        attribute.setRequiredLevel("required");
    }
}
async function setEmailTemplateByBrand(formContext)
{
    try
    {
        var subjectValue = formContext.getAttribute("subject")?.getValue() || "";
 
        var isReplyEmail =
            subjectValue.toUpperCase().startsWith("RE:") ||
            subjectValue.toUpperCase().startsWith("FW:");
 
        console.log("Email Template Processing Started");
 
// Allow Create and Reply/Reply All emails
var directionCode = formContext.getAttribute("directioncode")?.getValue();
if ((formContext.ui.getFormType() !== 1) &&
(formContext.ui.getFormType() !== 2 || directionCode !== true))
{
return;
}
 
        var caseDetails = await getCaseDetails(formContext);
 
        if (!caseDetails)
        {
            console.log("Case not found.");
            return;
        }
 
        var configRules = await getConfigurationRules();
 
        var matchedRule = findRule(configRules, caseDetails.brandValue);
 
        if (!matchedRule)
        {
            console.warn(
                "No template configuration found for Brand: " + caseDetails.brandValue);
            return;
        }
 
        var templateId = matchedRule.emailtemplateid;
 
        var senderQueueId = null;
 
        if (matchedRule.senders && matchedRule.senders.length > 0)
        {
            senderQueueId = matchedRule.senders[0];
        }
 
        var queue = null;
 
        if (senderQueueId)
        {
            queue = await getQueue(senderQueueId);
        }
 
        // ALWAYS SET SENDER
        if (queue)
        {
            setSender(
                formContext,
                queue,
                senderQueueId
            );
        }
 
        // REPLY / REPLY ALL / FORWARD
        if (isReplyEmail)
        {
            console.log("Reply/Reply All detected. Template skipped.");
            return;
        }
 
        // ONLY FOR NEW EMAILS
        var instantiatedResult = await instantiateTemplate(
            templateId,
            caseDetails.caseId
        );
 
        var template =
            instantiatedResult.value &&
            instantiatedResult.value.length > 0
                ? instantiatedResult.value[0]
                : null;
 
        if (!template)
        {
            throw new Error("No email content returned from template.");
        }
 
        var subject = template.subject || "";
 
        var description =
            template.description ||
            template.safehtml ||
            template.body ||
            "";
 
        setSubject(formContext, subject);
 
        setDescription(
            formContext,
            description
        );
 
        console.log("Email template populated successfully.");
    }
    catch (e)
    {
        console.error(e);
 
        Xrm.Navigation.openAlertDialog({
            text: "Unable to load Email Template. " + e.message
        });
    }
}

async function getCaseDetails(formContext)
{
	var attempts = 0;
	while (attempts < 10)
	{
		var regarding = formContext.getAttribute("regardingobjectid").getValue();
		if (
		regarding && regarding.length > 0 && regarding[0].entityType === "incident")
		{
			var caseId = regarding[0].id.replace(/[{}]/g, "");
			var incident = await Xrm.WebApi.retrieveRecord("incident",caseId,"?$select=cat_brand");
			return {
				caseId: caseId,
				brandValue: incident.cat_brand
			};
		}
		await new Promise(function (resolve)
		{
			setTimeout(resolve, 500);
		});
		attempts++;
	}
	return null;
};
async function getConfigurationRules()
{
	var result = await Xrm.WebApi.retrieveMultipleRecords(
		"cat_ccs_configuration",
		"?$select=cat_value&$filter=cat_key eq 'caseEmailTemplateRules'");
	if (!result.entities || result.entities.length === 0)
	{
		throw new Error(
			"Configuration record not found.");
	}
	var configValue = result.entities[0].cat_value;
	if (!configValue)
	{
		throw new Error(
			"Configuration value is empty.");
	}
	return JSON.parse(configValue);
};
function findRule(rules, brandValue)
{
	return rules.find(function (rule)
	{
		return (
		String(rule.brand) === String(brandValue));
	});
};
