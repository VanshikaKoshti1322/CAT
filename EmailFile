// ===== Email body helpers =====
// ===== Email body from To field =====
function escHtml(s) {
  return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
 
function buildEmailBody(name, number, description, ownerName) {
  return "<div>Hello " + escHtml(name) + ",<br><br>" +
    "Thank you for contacting Cat Customer Support.<br><br>" +
    "We received your inquiry, " + escHtml(number) + ", <b>Regarding:</b> " + escHtml(description) + "<br><br>" +
    "Your inquiry will be reviewed, and we will follow up with you as soon as possible with next steps.<br><br>" +
    "Regards,<br>" + escHtml(ownerName) + "<br>Cat&reg; Customer Support<br>" +
    "Note: Please do not provide passwords, credit card numbers or other confidential information via email.<br>" +
    "For office use only [Case reference data " + escHtml(number) + "].</div>";
}
 
function populateEmailBody(formContext) {
 alert("populateEmailBody: called");
 
  var toAttr = formContext.getAttribute("to");
  var body = formContext.getAttribute("description");
  var regardingAttr = formContext.getAttribute("regardingobjectid");
  var regarding = regardingAttr && regardingAttr.getValue();
 
  if (!toAttr || !body) { console.warn("populateEmailBody: 'to' or 'description' missing on this form"); return; }
  if (!regarding || regarding[0].entityType !== "incident") {
    console.warn("populateEmailBody: Regarding is empty or not a case");
    return;
  }
 
  Xrm.WebApi.retrieveRecord(
    "incident",
    regarding[0].id.replace(/[{}]/g, ""),
    "?$select=ticketnumber,description,_ownerid_value"
  ).then(function (c) {
    var number = c.ticketnumber;
    var caseDescription = c.description;
    var ownerName = c["_ownerid_value@OData.Community.Display.V1.FormattedValue"] || "";
    var lastHtml = "";
 
    function apply() {
      var parties = toAttr.getValue();
      if (!parties || !parties.length || !parties[0].name) return false; // To not ready yet
      lastHtml = buildEmailBody(parties[0].name, number, caseDescription, ownerName);
      body.setValue(lastHtml);
      console.log("populateEmailBody: body set for", parties[0].name);
      return true;
    }
 
    // To is often filled after the form loads, so retry briefly
    var tries = 0;
    var timer = setInterval(function () {
      tries++;
      if (apply() || tries >= 10) {
        clearInterval(timer);
        // Re-apply in case a template or another script overwrites the body later
        [1000, 2500, 4000].forEach(function (ms) {
          setTimeout(function () {
            if (lastHtml && body.getValue() !== lastHtml) body.setValue(lastHtml);
          }, ms);
        });
      }
    }, 500);
 
    // If someone changes To, refresh the greeting
    toAttr.addOnChange(apply);
  }, function (e) {
    console.error("populateEmailBody: retrieve failed:", e.message);
  });
}
