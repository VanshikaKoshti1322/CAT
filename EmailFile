async function instantiateTemplate(templateId, caseId) {
    const request = {
        TemplateId: templateId,
        ObjectId: caseId,
        ObjectType: "incident"
    };
    const response = await fetch(
        Xrm.Utility.getGlobalContext().getClientUrl() +
        "/api/data/v9.2/InstantiateTemplate",
        {
            method: "POST",
            headers: {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "OData-MaxVersion": "4.0",
                "OData-Version": "4.0"
            },
            body: JSON.stringify(request)
        }
    );
    if (!response.ok) {
        throw new Error(`Instantiate Template failed: ${response.status}`);
    }
    return await response.json();
}

