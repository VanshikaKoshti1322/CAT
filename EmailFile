/**
* Helper function to check if email already exists in CC
*/
function emailExistsInCC(ccParties, email) {
    if (!email || !ccParties || ccParties.length === 0) return false;
    var normalizedEmail = email.trim().toLowerCase();
    return ccParties.some(function (party) {
        return (
            party.entityType === "unresolvedaddress" &&
            party.name &&
            party.name.trim().toLowerCase() === normalizedEmail
        );
    });
}
CAT.Email.formLoad = async function (executionContext) {
        try {
        var formContext = executionContext.getFormContext();
        var directionCode = formContext.getAttribute("directioncode")?.getValue(); // true = outgoing

        if (formContext.ui.getFormType() !== 1) {
            if ((formContext.ui.getFormType() !== 2) && (directionCode !== true)) {
